rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Google accounts allowed to use the dashboard
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified
        && request.auth.token.email.lower() in ['manoj.g.prof@gmail.com', 'gmanojece2021@gmail.com'];
    }
    match /{document=**} { allow read, write: if isOwner(); }
  }
}
